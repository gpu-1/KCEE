{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCEE run manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "validation_status",
    "source_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_status": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
